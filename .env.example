# Server Configuration
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__GRPC_PORT=50051
SERVER__WORKERS=4

# Database Configuration
DATABASE__URL=postgresql://ussd_user:ussd_password@localhost:5432/ussd_db
DATABASE__MAX_CONNECTIONS=20

# Redis Configuration
REDIS__URL=redis://localhost:6379

# Session Configuration
SESSION__TIMEOUT_SECS=300
SESSION__MAX_SESSIONS_PER_USER=5

# Security Configuration
SECURITY__JWT_SECRET=your-super-secret-jwt-key-change-in-production
SECURITY__RATE_LIMIT_REQUESTS=100
SECURITY__RATE_LIMIT_WINDOW_SECS=60

# Observability Configuration
OBSERVABILITY__LOG_LEVEL=info
OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4317
OBSERVABILITY__ENABLE_METRICS=true

# Application
RUST_LOG=info,ussd_advanced=debug
